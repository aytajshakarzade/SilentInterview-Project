# Local development only. Never put real credentials in Git or a shared ZIP.
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:8080
Frontend__BaseUrl=http://localhost:5173
FRONTEND_ORIGIN=http://localhost:5173

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=silentinterview_db
PGUSER=postgres
PGPASSWORD=replace-with-local-password

# JWT
Jwt__Issuer=SilentInterview
Jwt__Audience=SilentInterviewUsers
Jwt__Key=replace-with-a-long-random-development-only-key

# Stripe test mode: fill these locally; never commit the values.
Stripe__SecretKey=sk_test_replace_me
Stripe__WebhookSecret=whsec_replace_me
Stripe__GoPriceId=price_1U9NWE0WSpP34h0NTC8Ljtxp
Stripe__ProPriceId=price_1U9NWZ0WSpP34h0NWToyhQLF

# Refresh cookie settings for local HTTP development.
Auth__RefreshCookieSameSite=Lax
Auth__RefreshCookieSecure=false
